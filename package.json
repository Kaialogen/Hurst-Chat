{
  "name": "hurst-chat-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @hurst-chat/frontend",
    "dev:backend": "npm run dev --workspace @hurst-chat/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace @hurst-chat/frontend",
    "build:backend": "npm run build --workspace @hurst-chat/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
